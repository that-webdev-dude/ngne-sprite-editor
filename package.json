{
    "name": "ngne-sprite-editor",
    "version": "1.0.0",
    "private": true,
    "description": "Browser pixel-art sprite editor rendered by the NGNE engine",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
    },
    "dependencies": {
        "@ngne/core": "0.2.1",
        "fast-png": "8.0.0",
        "fflate": "0.8.3",
        "gifenc": "1.0.3",
        "lucide-react": "1.55.0",
        "radix-ui": "1.7.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "zustand": "5.0.15"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.13.0",
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.64.0",
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "eslint": "10.12.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "fast-check": "4.10.2",
        "globals": "17.13.0",
        "prettier": "3.9.10",
        "typescript": "5.9.3",
        "typescript-eslint": "8.71.1",
        "vite": "8.3.4",
        "vite-plugin-pwa": "2.0.0",
        "vitest": "5.0.3"
    }
}
